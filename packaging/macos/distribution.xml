<?xml version="1.0" encoding="utf-8"?>
<!-- MiteFX for macOS: the installer's layout (productbuild; .github/workflows/release.yml fills __VERSION__). -->
<installer-gui-script minSpecVersion="2">
  <title>MiteFX</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <license file="LICENSE.txt"/>
  <options customize="never" require-scripts="true" hostArchitectures="x86_64,arm64"/>
  <domains enable_localSystem="true"/>
  <choices-outline>
    <line choice="mitefx"/>
  </choices-outline>
  <choice id="mitefx" title="MiteFX" description="The 19 Mite plugins, VST3 and CLAP, in /Library/Audio/Plug-Ins.">
    <pkg-ref id="io.github.miteffects.mitefx"/>
  </choice>
  <pkg-ref id="io.github.miteffects.mitefx" version="__VERSION__" onConclusion="none">mitefx.pkg</pkg-ref>
</installer-gui-script>
