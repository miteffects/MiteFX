{
  "$schema": "mitefx-tokens/1",
  "source": "https://claude.ai/artifact/W6i7s8rA3Q81U43ruRusH5 (Tokens, Components, Main artboards, first pass 2026-10-14)",
  "brand": {
    "wordmark": "miteFX",
    "wordmarkRule": "lower-case Manrope 800, 'FX' in the plugin accent",
    "font": "Manrope",
    "fontLicense": "OFL-1.1",
    "fontWeights": [400, 500, 600, 700, 800]
  },
  "color": {
    "dark": {
      "window": "#0A0C0F",
      "display": "#0E1116",
      "surface.1": "#10141A",
      "surface.2": "#12161C",
      "surface.3": "#1A1E25",
      "line.subtle": "#1C2129",
      "line.strong": "#2A313C",
      "text.lo": "#7C8696",
      "text.mid": "#A7B0BE",
      "text.hi": "#E6EAF0"
    },
    "light": {
      "window": "#EEF0F3",
      "display": "#FFFFFF",
      "surface.1": "#F6F7F9",
      "surface.2": "#E9ECF0",
      "surface.3": "#DDE1E7",
      "line.subtle": "#D5DAE1",
      "line.strong": "#B8BFC9",
      "text.lo": "#5F6875",
      "text.mid": "#3E4652",
      "text.hi": "#12161C"
    },
    "semantic": {
      "sem.gr": "#FF8A3D",
      "sem.sidechain": "#B38CFF",
      "sem.collision": "#FF4D6A",
      "sem.spec.pre": "#8A94A3",
      "sem.warn": "#FFB547",
      "sem.ok": "#8EE07A",
      "sem.focus": "#FFFFFF",
      "sem.mod": "#C9A7FF"
    },
    "bandRamp": ["#5CC8FF", "#FFB547", "#FF6FA8", "#8EE07A", "#B98BFF", "#F7D154", "#3FD6B5", "#FF8A5C"],
    "bandRampColorBlind": ["#56B4E9", "#E69F00", "#CC79A7", "#009E73", "#F0E442", "#0072B2", "#D55E00", "#E6EAF0"],
    "bandRampRule": "band 9+ repeats the ramp; the node number disambiguates",
    "pluginAccent": {
      "eq": "#5CC8FF",
      "comp": "#FF9F43",
      "limit": "#FF5E6C",
      "multiband": "#B98BFF",
      "verb": "#6F8CFF",
      "delay": "#3FD6B5",
      "sat": "#FF7A45",
      "deess": "#F7D154",
      "gate": "#9BE15D",
      "shape": "#FF6FB5",
      "soothe": "#7FE3C0",
      "filter": "#FFC15C",
      "mod": "#E07BFF",
      "meter": "#D6DCE4",
      "utility": "#9AA6B8"
    },
    "accentRule": "One hue per plugin. The accent paints the post spectrum, total-curve glow, latched toggles and the logo. Bands always use the band ramp. Semantic colours never change between plugins.",
    "display": {
      "grid.minor": "#151920",
      "grid.major": "#1D232C",
      "grid.zero": "#2A313C",
      "curve.total": "#DDF3FF",
      "curve.total.width": 2.2,
      "spec.pre.opacity": 0.45,
      "spec.post.line.opacity": 0.5,
      "spec.post.fill": [
        { "offset": 0.0, "color": "accent", "opacity": 0.34 },
        { "offset": 0.55, "color": "#3D6FD9", "opacity": 0.12 },
        { "offset": 1.0, "color": "#3D6FD9", "opacity": 0.0 }
      ],
      "band.fill.opacity": 0.08,
      "band.fill.opacity.selected": 0.22,
      "dyn.region.opacity": 0.14
    },
    "control": {
      "button.bg": "#12161C",
      "button.border": "#222832",
      "button.bg.hover": "#1A1F27",
      "button.border.hover": "#3A4250",
      "button.text": "#C9D1DC",
      "button.text.disabled": "#4A5260",
      "panel.control.bg": "#1E232B",
      "panel.control.border": "#2E3540",
      "segment.track.bg": "#0C0F13",
      "segment.track.border": "#1E242D",
      "segment.on.bg": "#262C36",
      "segment.on.text": "#F2F5F8",
      "segment.off.text": "#8A94A3",
      "field.bg": "#0C0F13",
      "knob.disc": "#161A21",
      "knob.disc.ring": "#2E3540",
      "knob.tick.dim": "#2A313C",
      "knob.tick.center": "#C9D1DC",
      "knob.pointer": "#FFFFFF",
      "slider.track": "#252B35",
      "slider.thumb": "#E6EAF0",
      "meter.well": "#0A0C10",
      "meter.well.border": "#1E242D",
      "meter.segment.off": "#1E242D",
      "toggle.off.track": "#252B35",
      "toggle.off.thumb": "#7C8696"
    }
  },
  "type": {
    "display":      { "size": 28,   "weight": 800, "tracking": "-0.02em" },
    "title":        { "size": 15,   "weight": 700 },
    "body":         { "size": 12,   "weight": 500 },
    "label":        { "size": 10,   "weight": 700, "tracking": "0.08em", "case": "upper" },
    "readout":      { "size": 11.5, "weight": 600, "features": ["tnum"] },
    "readout.dial": { "size": 12,   "weight": 700, "features": ["tnum"], "unitSize": 9 },
    "readout.lg":   { "size": 20,   "weight": 600, "tracking": "-0.01em", "features": ["tnum"] }
  },
  "space": { "s.1": 2, "s.2": 4, "s.3": 6, "s.4": 8, "s.5": 12, "s.6": 16, "s.7": 24, "s.8": 32, "s.9": 48 },
  "radius": { "r.xs": 2, "r.sm": 4, "r.md": 6, "r.lg": 10, "r.xl": 14, "r.pill": 20 },
  "radiusUse": { "r.xs": "meter", "r.sm": "chip", "r.md": "control", "r.lg": "card", "r.xl": "panel", "r.pill": "switch" },
  "elevation": {
    "raised": [
      { "inset": true, "x": 0, "y": 1, "blur": 0, "color": "rgba(255,255,255,0.06)" },
      { "x": 0, "y": 1, "blur": 2, "color": "rgba(0,0,0,0.7)" },
      { "x": 0, "y": 4, "blur": 12, "color": "rgba(0,0,0,0.4)" }
    ],
    "inset": [
      { "inset": true, "x": 0, "y": 1, "blur": 3, "color": "rgba(0,0,0,0.65)" }
    ],
    "glass.panel": {
      "fill": "rgba(24,28,35,0.72)",
      "backdropBlur": 18,
      "backdropSaturate": 1.2,
      "border": "rgba(255,255,255,0.09)",
      "shadow": [
        { "x": 0, "y": 18, "blur": 48, "color": "rgba(0,0,0,0.55)" },
        { "inset": true, "x": 0, "y": 1, "blur": 0, "color": "rgba(255,255,255,0.05)" }
      ]
    }
  },
  "glow": {
    "glow.curve": { "blur": 5, "mode": "blur + source" },
    "glow.knob.ticks": { "blur": 1.8, "mode": "blur + source" },
    "glow.knob.pointer": { "blur": 2.2, "mode": "drop-shadow in accent" },
    "glow.meter": { "blur": 2.4, "mode": "blur + source" },
    "glow.latched": { "outer": 14, "outerOpacity": 0.35, "inner": 10, "innerOpacity": 0.15, "textGlow": 8 },
    "glow.node.selected": { "ring": 5, "ringOpacity": 0.2, "blur": 18, "blurOpacity": 0.67 }
  },
  "motion": {
    "ease.standard": [0.2, 0, 0, 1],
    "ease.enter": [0, 0, 0.2, 1],
    "ease.exit": [0.4, 0, 1, 1],
    "spring.node": { "stiffness": 420, "damping": 28 },
    "dur.micro": 80,
    "dur.fast": 140,
    "dur.base": 220,
    "dur.slow": 360,
    "meter.attackMs": 0,
    "meter.releaseMs": 300,
    "hover.scale.knob": 1.1
  },
  "layout": {
    "eq.reference": { "w": 1280, "h": 760 },
    "header.h": 56,
    "helpStrip.h": 28,
    "footer.h": 56,
    "control.h": 32,
    "panelControl.h": 28,
    "segment.h": 26,
    "knob.standard": 64,
    "knob.small": 34,
    "node.idle": 14,
    "node.selected": 18,
    "node.hitTarget": 32,
    "bandPanel.w": 476,
    "outMeter.w": 33
  }
}
