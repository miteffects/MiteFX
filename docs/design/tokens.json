        "hc": "#ADC3F9",
        "cb": "#944B40",
        "cbCue": "dotted top edge; always rises from the bottom or the 0 dB line",
        "use": "upward gain (upward compression and upward expansion); mirrors gr, which always hangs from the top"
      }
