{
  "$schema": "mitefx-tokens/3",
  "meta": {
    "version": "0.4.0",
    "date": "2026-10-22",
    "note": "Fourth pass: Mite Comp. Comp accent moved from azure to ember (user decision); new semantic gainUp."
  },
  "color": {
    "rules": {
      "deltaE": "CIEDE2000",
      "minDeltaE": 15,
      "applies": "band-band, band-semantic, band-curve, semantic-semantic, accent-band, accent-semantic in every theme (dark, light, high contrast)",
      "colourBlind": "minimum CIEDE2000 12 (not 15: the CVD gamut is too small for 15 with 4 bands + 5 semantics); pairs checked as the minimum of normal, protanopia and deuteranopia simulation (Machado 2009); every semantic colour also has a non-colour cue",
      "ramp": "one fixed ramp for the whole suite; band 7+ repeats and the node number disambiguates",
      "accent": "accents never come from the ramp; modulation always draws in the accent (there is no sem.mod)",
      "solo": "white ring + S badge, other bands at 35 % opacity",
      "gainUp": "gainUp clears ramp, semantics, the curve and the Comp accent by >= 15 in dark/light/hc. It sits closer than 15 to a few pale accents of plugins that never draw upward gain (listed in semanticChecks)."
    },
    "ramp": {
