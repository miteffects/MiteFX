{
  "$schema": "mitefx-tokens/3",
  "meta": {
    "version": "0.6.0",
    "date": "2026-10-26",
    "note": "Sixth pass (in-house, no Claude Design): Mite Sat accent moved from salmon to crimson (user decision: Sat is red); accent exceptions made machine-readable."
  },
  "color": {
    "rules": {
      "deltaE": "CIEDE2000",
      "minDeltaE": 15,
      "applies": "band-band, band-semantic, band-curve, semantic-semantic, accent-band, accent-semantic in every theme (dark, light, high contrast)",
      "colourBlind": "minimum CIEDE2000 12 (not 15: the CVD gamut is too small for 15 with 4 bands + 5 semantics); pairs checked as the minimum of normal, protanopia and deuteranopia simulation (Machado 2009); every semantic colour also has a non-colour cue",
      "ramp": "one fixed ramp for the whole suite; band 7+ repeats and the node number disambiguates",
      "accent": "accents never come from the ramp; modulation always draws in the accent (there is no sem.mod)",
      "solo": "white ring + S badge, other bands at 35 % opacity",
      "gainUp": "gainUp clears ramp, semantics, the curve and the Comp accent by >= 15 in dark/light/hc. It sits closer than 15 to a few pale accents of plugins that never draw upward gain (listed in semanticChecks).",
      "frequencyBands": "Bands that are frequency regions (Mite Shape, Mite Multiband) are drawn in the plugin accent with their number, never in the ramp: the ramp means stereo placement (EQ). Selected band: accent at 100 % with glow. Other bands: accent edge at 55 %, region fill 10 %. Soloed: white ring + S badge, others at 35 %. Muted: region fill removed, 45° hatch in text.lo at 30 %, M badge in text.hi, its gain trace hidden.",
      "shaping": "Shaping gain is signed: boost rises in gainUp, cut hangs in gr, from a 0 dB line. Attack and sustain share those colours and differ by weight: the attack part (gain while the detector weight w > 0.5) is a solid fill at 70 % with glow; the sustain part is a 28 % fill with a 1.5 px edge and no glow. Each detected hit gets a 2 px accent tick hanging from the divider between the level and gain lanes; its height is the hit sharpness.",
      "satRed": "The Sat accent is a true red, within 15 of danger/masking in dark (2.9) and hc (5.6). Sat therefore never draws a danger or masking role: overs and clipping use warn, a delete button is text with a cross glyph. Exceptions are listed in accentExceptions and the test in mite-ui tokens.rs skips only those.",
      "accentExceptions": [
        [
          "mod",
          "gainUp"
        ],
        [
          "verb",
          "gainUp"
        ],
        [
          "meter",
          "gainUp"
        ],
        [
          "limit",
          "gainUp"
        ],
        [
          "utility",
          "gainUp"
        ],
        [
          "sat",
          "danger"
        ],
        [
          "sat",
          "masking"
        ]
      ]
    },
